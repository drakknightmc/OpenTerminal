# Server configuration
API_PORT=4000

# Anthropic API key for the AI assistant widget (optional)
# If unset, the /api/ai/chat endpoint will report "unavailable" in the status
ANTHROPIC_API_KEY=sk_test_...

# Web frontend configuration
# URL of the backend API server (used in Next.js rewrites)
# Defaults to http://localhost:4000 if unset
API_URL=http://localhost:4000
